# Variáveis de ambiente da stack de produção (docker-compose.prod.yml).
# Configure estes valores no painel do Dokploy (aba "Environment" da app) —
# nunca commite os valores reais, só este template.
#
# Postgres, MongoDB e Keycloak rodam em outro lugar (outros serviços já
# existentes) — aqui só entram os dados de CONEXÃO com eles.

# JDBC do Postgres já existente (rode antes scripts/bootstrap-postgres.sql lá).
SPRING_DATASOURCE_URL=jdbc:postgresql://SEU_HOST_POSTGRES:5432/tetopro_obra
SPRING_DATASOURCE_USERNAME=tetopro_obra
SPRING_DATASOURCE_PASSWORD=

# URI do MongoDB já existente (rode antes scripts/bootstrap-mongo.js lá).
SPRING_DATA_MONGODB_URI=mongodb://tetopro_obra:SENHA@SEU_HOST_MONGO:27017

# Precisa ser EXATAMENTE o mesmo valor configurado no "secret" do client
# "tetopro-obra-backend" no realm importado no Keycloak já existente
# (backend/src/main/resources/keycloak/realm-tetopro-obra.json) — troque
# o valor de desenvolvimento nos dois lugares antes de subir.
TETOPRO_OBRA_KEYCLOAK_ADMIN_SECRET=
