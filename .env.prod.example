# Variáveis de ambiente da stack de produção (docker-compose.prod.yml).
# Configure estes valores no painel do Dokploy (aba "Environment" da app) —
# nunca commite os valores reais, só este template.
#
# Gere segredos fortes com, por exemplo: openssl rand -base64 32

POSTGRES_DB=tetopro_obra
POSTGRES_USER=tetopro_obra
POSTGRES_PASSWORD=

MONGO_USER=tetopro_obra
MONGO_PASSWORD=

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Precisa ser EXATAMENTE o mesmo valor configurado no "secret" do client
# "tetopro-obra-backend" em backend/src/main/resources/keycloak/realm-tetopro-obra.json
# — troque o valor de desenvolvimento nos dois lugares antes de subir.
TETOPRO_OBRA_KEYCLOAK_ADMIN_SECRET=
